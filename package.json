{
  "name": "@withone/mastra",
  "version": "0.0.0",
  "description": "Use every app connected through One as typed Mastra tools.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./provider": {
      "import": {
        "types": "./dist/provider.d.ts",
        "default": "./dist/provider.js"
      },
      "require": {
        "types": "./dist/provider.d.cts",
        "default": "./dist/provider.cjs"
      }
    },
    "./workflows": {
      "import": {
        "types": "./dist/workflows.d.ts",
        "default": "./dist/workflows.js"
      },
      "require": {
        "types": "./dist/workflows.d.cts",
        "default": "./dist/workflows.cjs"
      }
    },
    "./triggers": {
      "import": {
        "types": "./dist/triggers.d.ts",
        "default": "./dist/triggers.js"
      },
      "require": {
        "types": "./dist/triggers.d.cts",
        "default": "./dist/triggers.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.76.0 <2.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mastra/core": "^1.77.0",
    "@mastra/editor": "^0.16.2",
    "@mastra/libsql": "^1.26.1",
    "@types/node": "^26.6.5",
    "@withone/connect": "^0.17.1",
    "eslint": "^9.39.5",
    "mastra": "^1.34.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@mastra/editor": {
      "optional": true
    }
  },
  "bin": {
    "withone-mastra": "./dist/cli.js"
  },
  "module": "./dist/index.js"
}
