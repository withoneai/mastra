{
  "name": "@withone/mastra",
  "version": "0.0.0",
  "description": "Use every app connected through One as typed Mastra tools.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./triggers": {
      "types": "./dist/triggers.d.ts",
      "import": "./dist/triggers.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.76.0 <2.0.0",
    "zod": "^3.25.0 || ^4.0.0",
    "@withone/connect": ">=0.17.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.77.0",
    "@mastra/editor": "^0.16.2",
    "@mastra/libsql": "^1.26.1",
    "@types/node": "^26.6.5",
    "@withone/connect": "^0.17.1",
    "mastra": "^1.34.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@withone/connect": {
      "optional": true
    },
    "@mastra/editor": {
      "optional": true
    }
  }
}
